# URL base do Scripted REST do ServiceNow (Portal de Disponibilidade)
VITE_SERVICENOW_BASE_URL=https://devitsmbb.service-now.com/api/x_bdb_5ul_00000368/indicador

# Tamanho (em meses) da janela de histórico ao clicar numa apuração (padrão: 6)
VITE_HISTORICO_MESES=6

# URL base do backend do Portal (mesmo do front-bb) usada para GET /auth (autenticação SSO)
VITE_API_URL=https://pxl1ath00001.dispositivos.bb.com.br:3333

# Ambiente: se definido (ex.: dev), usa o usuário mockado e ignora o SSO.
# Deixe VAZIO/removido em produção para forçar a autenticação SSO.
VITE_ENV=dev
